{
  "name": "@atlcli/extension",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst",
    "dev": "wxt",
    "prebuild": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst && bun run --cwd ../.. clean:extension-output",
    "build": "wxt build",
    "prepdf:fixture": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst",
    "pdf:fixture": "bun scripts/render-pdf-fixture.ts",
    "pretest:viewer-browser": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst",
    "test:viewer-browser": "playwright test --config tests/pdf/browser/playwright.config.ts",
    "pretest:worker-extension-browser": "bun run build",
    "test:worker-extension-browser": "bun run test:worker-extension-browser:prebuilt",
    "test:worker-extension-browser:prebuilt": "playwright test --config tests/pdf/extension-worker/playwright.config.ts",
    "pretest:jobs-extension-browser": "bun run build",
    "test:jobs-extension-browser": "bun run test:jobs-extension-browser:prebuilt",
    "test:jobs-extension-browser:prebuilt": "node --conditions=development node_modules/@playwright/test/cli.js test --config tests/jobs/packed/playwright.config.ts",
    "prebench:memory-chrome": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst && bun --conditions=development tests/pdf/memory/generate-corpus.ts && vite build --config tests/pdf/memory/vite.config.ts",
    "bench:memory-chrome": "playwright test --config tests/pdf/memory/playwright.config.ts",
    "prebench:export-baseline-chrome": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst && vite build --config tests/export-baseline/vite.config.ts",
    "bench:export-baseline-chrome": "playwright test --config tests/export-baseline/playwright.config.ts",
    "prebench:export-jobs-chrome": "bun run --cwd ../.. fonts:ensure && bun run --cwd ../.. vendor:typst && vite build --config tests/export-job-baseline/vite.config.ts",
    "bench:export-jobs-chrome": "playwright test --config tests/export-job-baseline/playwright.config.ts",
    "research:live": "bun --env-file=../../.env --conditions=development scripts/research-agent-live.ts",
    "research:live:mayflower": "bun --env-file=../../.env --conditions=development scripts/research-agent-live-mayflower.ts",
    "postinstall": "wxt prepare",
    "pretypecheck": "bun run --cwd ../.. fonts:ensure",
    "typecheck": "wxt prepare && tsc --noEmit",
    "check:output": "bun scripts/check-output-build.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.2",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-sdk": "1.9.28",
    "@langchain/quickjs": "1.0.0",
    "@atlcli/code-highlight": "workspace:*",
    "@atlcli/confluence": "workspace:*",
    "@atlcli/core": "workspace:*",
    "@atlcli/docx": "workspace:*",
    "@atlcli/export-fixtures": "workspace:*",
    "@atlcli/export-jobs": "workspace:*",
    "@atlcli/export-macros": "workspace:*",
    "@atlcli/export-wiring": "workspace:*",
    "@atlcli/jira": "workspace:*",
    "@atlcli/pdf": "workspace:*",
    "@atlcli/pdf-compiler-browser": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepagents": "1.12.0",
    "langchain": "1.5.4",
    "langsmith": "0.7.17",
    "lucide-react": "^1.25.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.2",
    "tailwindcss": "^4.3.3",
    "vite": "8.1.4",
    "wxt": "^0.20.27"
  }
}
