{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".wxt/**"],
      "inputs": [
        "entrypoints/**",
        "utils/**",
        "workers/**",
        "types/**",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/confluence/src/**",
        "$TURBO_ROOT$/packages/diagram/src/**",
        "$TURBO_ROOT$/packages/docx/src/**",
        "$TURBO_ROOT$/packages/pdf/src/**",
        "$TURBO_ROOT$/packages/pdf-compiler-browser/src/**",
        "$TURBO_ROOT$/packages/pdf/scripts/ensure-fonts.ts",
        "$TURBO_ROOT$/packages/pdf/.fonts/**",
        "$TURBO_ROOT$/packages/pdf/licenses/**",
        "$TURBO_ROOT$/LICENSE",
        "wxt.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "typecheck": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "entrypoints/**",
        "utils/**",
        "workers/**",
        "types/**",
        "scripts/**",
        "tests/**",
        "wxt.config.ts",
        "env.d.ts",
        "tsconfig.json",
        "package.json"
      ]
    }
  }
}
