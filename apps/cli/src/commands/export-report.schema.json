{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlcli.dev/schemas/export-report-1.json",
  "title": "atlcli.export-report/1",
  "description": "The stable machine-readable report emitted by `atlcli wiki export` under --json / --report json. Additive changes only; a breaking change bumps the schema string. Note the one widening within /1: issue.severity gained `info` when severity started honouring the engine note level, so informational notes stopped inflating `warnings[]` and `--strict`.",
  "type": "object",
  "required": ["schema", "format", "sourcePages", "outputDetails", "outputs", "issues", "warnings", "errors", "timings", "exitCode"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "atlcli.export-report/1" },
    "format": { "enum": ["pdf", "docx"] },
    "engine": {
      "enum": ["python", "ts"],
      "description": "Current producers emit `ts`; `python` remains accepted so archived atlcli.export-report/1 documents stay valid."
    },
    "codeTheme": {
      "type": "string",
      "description": "Effective bundled Shiki theme used for code blocks."
    },
    "outputPolicy": { "$ref": "#/definitions/outputPolicy" },
    "outputStandardEvidence": { "$ref": "#/definitions/outputStandardEvidence" },
    "sourcePages": {
      "type": "array",
      "description": "One entry per source page — provenance/fetch-and-compose status only, NO per-page metrics.",
      "items": {
        "type": "object",
        "required": ["id", "title", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "notes": { "type": "array", "items": { "$ref": "#/definitions/issue" } }
        }
      }
    },
    "outputDetails": {
      "type": "array",
      "description": "One entry per compiled artifact (outputs[]). Per-artifact metrics live here, never invented per-sourcePages fields. Exactly one entry per scope today (artifact-cardinality contract).",
      "items": {
        "type": "object",
        "required": ["output", "embeddedImages", "renderedDiagrams", "skippedAssets"],
        "additionalProperties": false,
        "properties": {
          "output": { "type": "string" },
          "pageCount": { "type": "integer", "minimum": 0 },
          "embeddedImages": { "type": "integer", "minimum": 0 },
          "renderedDiagrams": { "type": "integer", "minimum": 0 },
          "skippedAssets": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "issues": { "type": "array", "items": { "$ref": "#/definitions/issue" }, "description": "Every issue, at every severity. There is no `infos` convenience view — read severity==info off here or off notesByCode." },
    "warnings": { "type": "array", "items": { "$ref": "#/definitions/issue" }, "description": "Convenience view: issues with severity==warning. Informational notes are NOT included (they were, before severity honoured the engine note level)." },
    "errors": { "type": "array", "items": { "$ref": "#/definitions/issue" }, "description": "Convenience view: issues with severity==error." },
    "timings": { "type": "object", "additionalProperties": { "type": "number" } },
    "exitCode": {
      "type": "integer",
      "description": "0 success; 1 usage/config/IO; 2 strict warnings; 3 auth; 4 remote/API; 5 compile/validate; 130 cancelled.",
      "enum": [0, 1, 2, 3, 4, 5, 130]
    },
    "requestedScope": {
      "type": "object",
      "description": "The scope as requested by flags (spec 002 traceability).",
      "additionalProperties": true
    },
    "resolvedScope": {
      "type": "object",
      "description": "The resolved scope (e.g. a space request resolved to a tree rooted at the homepage id).",
      "additionalProperties": true
    },
    "complete": {
      "type": "boolean",
      "description": "False when the composed document omitted content (partial mode)."
    },
    "notesByCode": {
      "type": "object",
      "description": "Per-code tally over issues[].",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "placeholders": {
      "type": "object",
      "description": "DOCX ts-engine placeholder metrics.",
      "required": ["resolved", "unsupported"],
      "additionalProperties": false,
      "properties": {
        "resolved": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "outputPolicy": {
      "type": "object",
      "required": ["schema", "standards"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "atlcli.pdf-output-policy/1" },
        "standards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["a-1b", "a-1a", "a-2b", "a-2u", "a-2a", "a-3b", "a-3u", "a-3a", "a-4", "a-4f", "a-4e", "ua-1"] }
        }
      }
    },
    "outputStandardEvidence": {
      "type": "object",
      "required": ["schema", "requestedStandard", "basePdfVersion", "hasDocumentIdentifier", "tagged", "hasLang", "embeddedFontFiles"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "atlcli.pdf-output-standard-evidence/1" },
        "requestedStandard": { "enum": ["a-1b", "a-1a", "a-2b", "a-2u", "a-2a", "a-3b", "a-3u", "a-3a", "a-4", "a-4f", "a-4e", "ua-1"] },
        "basePdfVersion": { "enum": ["1.4", "1.5", "1.6", "1.7", "2.0"] },
        "pdfa": {
          "type": "object",
          "required": ["part"],
          "additionalProperties": false,
          "properties": {
            "part": { "enum": ["1", "2", "3", "4"] },
            "conformance": { "enum": ["A", "B", "E", "F", "U"] }
          }
        },
        "pdfua": {
          "type": "object",
          "required": ["part"],
          "additionalProperties": false,
          "properties": { "part": { "const": "1" } }
        },
        "hasDocumentIdentifier": { "type": "boolean" },
        "tagged": { "type": "boolean" },
        "hasLang": { "type": "boolean" },
        "embeddedFontFiles": { "type": "integer", "minimum": 1 }
      }
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "phase", "retryable"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": {
          "enum": ["error", "warning", "info"],
          "description": "`info` mirrors an engine note with level==info (an observation about a correct export). Added in the same change that made severity honour the note level; a consumer pinned to an older copy of this file must widen its enum."
        },
        "phase": { "type": "string" },
        "retryable": { "type": "boolean" },
        "message": { "type": "string" },
        "status": { "type": "integer" },
        "sourcePageId": { "type": "string" },
        "path": { "type": "string" },
        "startLine": { "type": "integer" },
        "details": {
          "type": "object",
          "description": "Structured payload for typed errors (affected pages, budget offenders, ...).",
          "additionalProperties": true
        }
      }
    }
  }
}
