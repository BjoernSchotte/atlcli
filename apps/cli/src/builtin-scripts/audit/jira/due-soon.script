// Open issues due within the next days.
export const meta = {
  audit: {
    id: "hygiene/due-soon",
    product: "jira",
    title: "Due soon",
    category: "hygiene",
    kind: "until",
    fields: ["duedate"],
    profiles: { default: { info: "3d" }, strict: { warning: "3d" } },
  },
};

const DAY = 86_400_000;
const dueEnd = (due) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(due);
  return m ? Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]) + 1) : undefined;
};

export default (issue, rule) => {
  const due = issue.fields.duedate;
  const end = due ? dueEnd(due) : undefined;
  if (end === undefined || rule.now >= end) return;
  const left = (end - rule.now) / DAY;
  const hit = rule.severity(left);
  if (hit) return rule.finding({ severity: hit.severity, detail: `Due ${due.slice(0, 10)}, in ${Math.ceil(left)} d.` });
};
