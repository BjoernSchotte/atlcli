// Pages with view or edit restrictions (read live, one request per page).
export const meta = {
  audit: {
    id: "content/restricted",
    product: "confluence",
    title: "Restricted pages",
    category: "content",
    legacy: "restricted",
    needs: ["restrictions"],
    profiles: { default: "info", strict: "info" },
  },
};

export default (page, rule) => {
  if (page.restricted) return rule.finding({ detail: "Has view or edit restrictions." });
};
