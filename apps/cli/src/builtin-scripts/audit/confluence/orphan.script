// Pages no other page links to and that have no parent.
// --fix moves orphans not edited for a year to the trash.
export const meta = {
  audit: {
    id: "links/orphan",
    product: "confluence",
    title: "Orphaned pages",
    category: "links",
    legacy: "orphans",
    needs: ["links"],
    profiles: { default: "warning", strict: "warning" },
  },
};

const YEAR = 365 * 86_400_000;

export default (page, rule) => {
  if (page.synced && page.orphan) return rule.finding({ detail: "No incoming links and no parent." });
};

export async function fix(finding, page) {
  if (!page || !page.lastModified || Date.now() - Date.parse(page.lastModified) < YEAR) return;
  await atlcli.confluence.deletePage(page.id);
}
