// Sums the time logged per person and issue in a project over the last days
// and writes it as CSV, ready for a spreadsheet. The file is written row by
// row while the script runs; no --apply needed.
//
//   atlcli script run worklog-report.ts --param project=ATLCLI --param days=14 --out-dir reports
export const meta = {
  description: "Write the time logged per person and issue as CSV",
  permissions: ["jira:read", "file:output"],
  params: { project: { type: "string" }, days: { type: "number", default: 14 } },
};

const { project, days } = atlcli.params as { project: string; days: number };
const since = Date.now() - days * 86_400_000;
const out = await atlcli.output(`worklogs-${project}.csv`);
await out.row(["issue", "summary", "person", "hours"]);
let rows = 0;
for await (const issue of atlcli.jira.search(`project = ${project} AND worklogDate >= -${days}d`, { fields: ["summary"] })) {
  const perPerson = new Map<string, number>();
  for (const log of await atlcli.jira.worklogs(issue.key)) {
    if (Date.parse(log.started) < since) continue;
    const who = log.author?.displayName ?? "unknown";
    perPerson.set(who, (perPerson.get(who) ?? 0) + log.timeSpentSeconds);
  }
  for (const [who, seconds] of perPerson) {
    await out.row([issue.key, String(issue.fields.summary), who, (seconds / 3600).toFixed(2)]);
    rows++;
  }
}

export default { rows, file: await out.close() };
