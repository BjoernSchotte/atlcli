{
  "name": "@atlcli/cli",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "atlcli": "src/index.ts"
  },
  "dependencies": {
    "@atlcli/change-set": "workspace:*",
    "@atlcli/code-highlight": "workspace:*",
    "@atlcli/confluence": "workspace:*",
    "@atlcli/core": "workspace:*",
    "@atlcli/docx": "workspace:*",
    "@atlcli/docx-template-intake": "workspace:*",
    "@atlcli/export-blocks": "workspace:*",
    "@atlcli/export-jobs": "workspace:*",
    "@atlcli/export-macros": "workspace:*",
    "@atlcli/export-node": "workspace:*",
    "@atlcli/export-wiring": "workspace:*",
    "@atlcli/import-docx": "workspace:*",
    "@atlcli/jira": "workspace:*",
    "@atlcli/pdf": "workspace:*",
    "@atlcli/pdf-compiler-browser": "workspace:*",
    "@atlcli/pdf-template-authoring": "workspace:*",
    "@atlcli/plugin-api": "workspace:*",
    "@atlcli/research": "workspace:*",
    "@atlcli/template-pack": "workspace:*",
    "@atlcli/web-publish": "workspace:*",
    "@atlcli/web-publish-astro": "workspace:*",
    "@atlcli/web-publish-starlight": "workspace:*",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "0.32.0",
    "@resvg/resvg-wasm": "2.6.2",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun run build.ts",
    "build:minify": "bun run build.ts --minify",
    "research:e2e:source": "bun --env-file=../../.env --conditions=development src/e2e/research-live.ts --mode source",
    "research:e2e:built": "bun --env-file=../../.env --conditions=development src/e2e/research-live.ts --mode built",
    "research:e2e:multi-turn": "bun --env-file=../../.env --conditions=development src/e2e/research-multi-turn.ts --mode source",
    "research:e2e:private-suite": "bun --env-file=../../.env --conditions=development src/e2e/research-private-suite.ts --mode source",
    "chat:e2e:private-suite": "bun --env-file=../../.env --conditions=development src/e2e/chat-private-suite.ts --mode source"
  },
  "devDependencies": {
    "@atlcli/export-fixtures": "workspace:*",
    "@langchain/core": "1.2.3",
    "ajv": "^8.20.0"
  }
}
