{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": [],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/docx/fonts/**",
        "$TURBO_ROOT$/packages/pdf/scripts/ensure-fonts.ts",
        "$TURBO_ROOT$/packages/pdf/.fonts/**",
        "$TURBO_ROOT$/packages/pdf/licenses/**",
        "$TURBO_ROOT$/packages/pdf-compiler-browser/scripts/**",
        "$TURBO_ROOT$/packages/pdf-compiler-browser/vendor/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/scripts/clean-browser-artifacts.ts",
        "$TURBO_ROOT$/LICENSE"
      ]
    },
    "typecheck": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/docx/fonts/**",
        "$TURBO_ROOT$/packages/pdf/scripts/ensure-fonts.ts",
        "$TURBO_ROOT$/packages/pdf/.fonts/**",
        "$TURBO_ROOT$/packages/pdf/licenses/**",
        "$TURBO_ROOT$/packages/pdf-compiler-browser/scripts/**",
        "$TURBO_ROOT$/packages/pdf-compiler-browser/vendor/**",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/LICENSE"
      ]
    },
    "check:output": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["test-results/**"]
    }
  }
}
