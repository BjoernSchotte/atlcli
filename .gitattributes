# Reproducible cross-platform vendoring (spec 009).
#
# `@atlcli/pdf-compiler-browser` vendors the typst.ts wasm-bindgen glue
# (`typst_ts_web_compiler.mjs`) and pins its sha256 in `TYPST_VENDOR_PINS`.
# Bun copies a patch's added lines verbatim, so with `core.autocrlf=true` (the
# Windows default) a CRLF checkout of a patch or of committed glue would change
# the bytes and fail the pin. Force LF on patches and text glue so the bytes are
# identical on macOS/Linux/Windows regardless of autocrlf.
patches/** text eol=lf
*.mjs text eol=lf
*.d.ts text eol=lf

# The agent skill is read by agents and installers byte for byte, and the CLI
# embeds it in every build, so a CRLF checkout must not change what it contains.
skills/** text eol=lf
# Shows the <<<<<<< LOCAL / >>>>>>> REMOTE markers sync writes; not a leftover merge conflict.
skills/atlcli/references/confluence-docs-sync.md conflict-marker-size=32

# Binary assets must NEVER be line-ending normalized — normalization would
# corrupt them and the wasm/font sha pins depend on their exact bytes.
*.wasm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
packages/**/fixtures/**/publication/assets/** binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.dotx binary
*.xlsx binary
*.pptx binary
