{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package.json", "bun.lock", "tsconfig.json"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["../../dist/**", "dist/**"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json"]
    },
    "//#check:browser": {
      "cache": true,
      "inputs": [
        "scripts/check-browser-build.ts",
        "packages/confluence/src/**/*.ts",
        "packages/jira/src/**/*.ts",
        "packages/core/src/**/*.ts",
        "packages/docx/src/**/*.ts",
        "packages/pdf/src/**/*.ts",
        "packages/diagram/src/**/*.ts"
      ]
    }
  }
}
