{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package.json", "tsconfig.json"],
  "tasks": {
    "typecheck": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/patches/**"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/patches/**"
      ]
    },
    "//#typecheck:root": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "tsconfig.json",
        "package.json",
        "bun.lock",
        "apps/*/package.json",
        "apps/*/src/**",
        "packages/*/package.json",
        "packages/*/src/**",
        "scripts/**/*.ts",
        "patches/**"
      ]
    },
    "//#check:browser:internal": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "bun.lock",
        "scripts/check-browser-build.ts",
        "packages/*/src/**",
        "packages/docx/fonts/**",
        "packages/pdf/.fonts/**",
        "packages/pdf/licenses/**",
        "packages/pdf/scripts/ensure-fonts.ts",
        "packages/pdf-compiler-browser/scripts/**",
        "packages/pdf-compiler-browser/vendor/**",
        "patches/**",
        "LICENSE"
      ]
    }
  }
}
