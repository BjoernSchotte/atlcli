{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package.json", "bun.lock", "tsconfig.json"],
  "tasks": {
    "typecheck": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/patches/**"
      ]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/patches/**"
      ]
    },
    "//#check:browser:internal": {
      "cache": true,
      "outputs": [],
      "inputs": [
        "scripts/check-browser-build.ts",
        "packages/*/src/**",
        "packages/docx/fonts/**",
        "packages/pdf/.fonts/**",
        "packages/pdf/licenses/**",
        "packages/pdf/scripts/ensure-fonts.ts",
        "packages/pdf-compiler-browser/scripts/**",
        "packages/pdf-compiler-browser/vendor/**",
        "patches/**",
        "LICENSE"
      ]
    }
  }
}
