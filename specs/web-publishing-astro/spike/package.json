{
  "name": "@atlcli/web-publishing-astro-t0",
  "version": "0.0.0-t0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "integration",
    "render-kit",
    "sites/*"
  ],
  "scripts": {
    "build:plain": "bun run --cwd sites/plain build",
    "build:starlight": "bun run --cwd sites/starlight build",
    "test": "bun test",
    "typecheck": "bun run --cwd sites/plain check && bun run --cwd sites/starlight check"
  },
  "overrides": {
    "@astrojs/internal-helpers": "0.10.2",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/markdown-satteri": "0.3.5",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@pagefind/default-ui": "1.5.2",
    "astro-expressive-code": "0.44.1",
    "pagefind": "1.5.2",
    "sharp": "0.34.5"
  }
}
