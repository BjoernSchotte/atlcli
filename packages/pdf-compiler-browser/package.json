{
  "name": "@atlcli/pdf-compiler-browser",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "atlcli": {
    "publish": "public-0.x"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun ../../scripts/strip-dev-condition.ts strip",
    "postpack": "bun ../../scripts/strip-dev-condition.ts restore"
  },
  "dependencies": {
    "@atlcli/pdf": "workspace:*",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0"
  }
}
