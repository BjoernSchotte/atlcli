{
  "name": "@atlcli/research",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "atlcli": {
    "publish": "public-0.x"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "browser": "./src/index.browser.ts",
        "default": "./src/index.ts"
      },
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "development": "./src/index.browser.ts",
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/index.browser.js"
    },
    "./browser/agent": {
      "development": "./src/index.agent.browser.ts",
      "types": "./dist/index.agent.browser.d.ts",
      "default": "./dist/index.agent.browser.js"
    },
    "./contracts": {
      "development": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./chat-contracts": {
      "development": "./src/chat-agent/contracts.ts",
      "types": "./dist/chat-agent/contracts.d.ts",
      "default": "./dist/chat-agent/contracts.js"
    },
    "./events": {
      "development": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./capability-contracts": {
      "development": "./src/capability-contracts.ts",
      "types": "./dist/capability-contracts.d.ts",
      "default": "./dist/capability-contracts.js"
    },
    "./scope-discovery": {
      "development": "./src/scope-discovery.ts",
      "types": "./dist/scope-discovery.d.ts",
      "default": "./dist/scope-discovery.js"
    },
    "./scope-catalog": {
      "development": "./src/scope-catalog.ts",
      "types": "./dist/scope-catalog.d.ts",
      "default": "./dist/scope-catalog.js"
    },
    "./scope-catalog-broker": {
      "development": "./src/scope-catalog-broker.ts",
      "types": "./dist/scope-catalog-broker.d.ts",
      "default": "./dist/scope-catalog-broker.js"
    },
    "./graph": {
      "development": "./src/graph.ts",
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./node": {
      "development": "./src/index.node.ts",
      "types": "./dist/index.node.d.ts",
      "default": "./dist/index.node.js"
    },
    "./bun": {
      "development": "./src/index.bun.ts",
      "types": "./dist/index.bun.d.ts",
      "default": "./dist/index.bun.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "bun ../../scripts/strip-dev-condition.ts strip",
    "postpack": "bun ../../scripts/strip-dev-condition.ts restore"
  },
  "dependencies": {
    "@atlcli/confluence": "workspace:*",
    "@atlcli/core": "workspace:*",
    "@atlcli/jira": "workspace:*",
    "@langchain/anthropic": "1.5.2",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/langgraph-sdk": "1.9.28",
    "@langchain/quickjs": "https://pkg.pr.new/@langchain/quickjs@717",
    "deepagents": "https://pkg.pr.new/deepagents@717",
    "langchain": "1.5.4",
    "langsmith": "0.7.17",
    "zod": "4.4.3"
  }
}
