{
  "name": "@atlcli/pdf",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "atlcli": {
    "publish": "public-0.x"
  },
  "sideEffects": false,
  "files": [
    "dist",
    ".fonts",
    "licenses",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": {
        "browser": "./src/index.browser.ts",
        "default": "./src/index.ts"
      },
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "development": "./src/index.browser.ts",
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/index.browser.js"
    },
    "./template": {
      "development": "./src/template.ts",
      "types": "./dist/template.d.ts",
      "default": "./dist/template.js"
    },
    "./internal": {
      "development": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./fonts/*": "./.fonts/*",
    "./licenses/*": "./licenses/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "bun scripts/ensure-fonts.ts && bun ../../scripts/strip-dev-condition.ts strip",
    "postpack": "bun ../../scripts/strip-dev-condition.ts restore",
    "lint:pdf-ledger": "bun scripts/check-hardcoding-ledger.ts"
  },
  "dependencies": {
    "@atlcli/code-highlight": "workspace:*",
    "@atlcli/export-macros": "workspace:*",
    "@atlcli/confluence": "workspace:*",
    "@atlcli/export-media": "workspace:*",
    "@atlcli/diagram": "workspace:*",
    "@atlcli/pdf-template-authoring": "workspace:*",
    "@atlcli/template-pack": "workspace:*"
  },
  "devDependencies": {
    "@atlcli/docx": "workspace:*"
  }
}
