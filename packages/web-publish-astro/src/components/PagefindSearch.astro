---
interface Props { base?: string; labels?: readonly string[]; shortcut?: "mod+k" | "/" | "none"; }
const { base = "/", labels = [], shortcut = "mod+k" } = Astro.props;
const normalizedBase = base === "/" ? "/" : `${base.replace(/^\/+|\/+$/gu, "")}/`;
---
<section data-atlcli-search data-pagefind-url={`${normalizedBase}pagefind/pagefind.js`} data-shortcut={shortcut} aria-label="Search">
  <button type="button" data-atlcli-search-trigger aria-haspopup="dialog">Search</button>
  <dialog data-atlcli-search-dialog aria-label="Search documentation"><form method="dialog"><button type="submit" aria-label="Close search">Close</button></form><label>Search <input type="search" data-atlcli-search-input autocomplete="off" /></label>{labels.length > 0 && <label>Label <select data-atlcli-search-filter><option value="">All labels</option>{labels.map((label) => <option value={label}>{label}</option>)}</select></label>}<p data-atlcli-search-status aria-live="polite"></p><ol data-atlcli-search-results></ol></dialog>
</section>
<script is:inline>
(() => { const root = document.querySelector('[data-atlcli-search]'); if (!(root instanceof HTMLElement)) return; const trigger = root.querySelector('[data-atlcli-search-trigger]'), dialog = root.querySelector('[data-atlcli-search-dialog]'), input = root.querySelector('[data-atlcli-search-input]'), filter = root.querySelector('[data-atlcli-search-filter]'), status = root.querySelector('[data-atlcli-search-status]'), results = root.querySelector('[data-atlcli-search-results]'); if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !(status instanceof HTMLElement) || !(results instanceof HTMLOListElement)) return; let pagefind; const open = () => { dialog.showModal(); input.focus(); }; trigger.addEventListener('click', open); document.addEventListener('keydown', (e) => { const s = root.dataset.shortcut; if ((s === 'mod+k' && (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') || (s === '/' && e.key === '/' && document.activeElement === document.body)) { e.preventDefault(); open(); }}); const search = async () => { const q = input.value.trim(); results.replaceChildren(); if (!q) { status.textContent = ''; return; } status.textContent = 'Searching…'; try { pagefind ??= await import(root.dataset.pagefindUrl); await pagefind.init(); const v = filter instanceof HTMLSelectElement ? filter.value : ''; const found = await pagefind.search(q, v ? { filters: { label: v } } : undefined); for (const entry of await Promise.all(found.results.slice(0, 20).map((r) => r.data()))) { const item = document.createElement('li'), link = document.createElement('a'), excerpt = document.createElement('p'); link.href = entry.url; link.textContent = entry.meta.title || entry.url; excerpt.textContent = entry.excerpt || ''; item.append(link, excerpt); results.append(item); } status.textContent = `${found.results.length} result${found.results.length === 1 ? '' : 's'}`; } catch { status.textContent = 'Search is temporarily unavailable.'; } }; input.addEventListener('input', () => void search()); filter?.addEventListener('change', () => void search()); })();
</script>
