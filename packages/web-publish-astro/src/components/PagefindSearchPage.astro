---
import { DEFAULT_PAGEFIND_SEARCH_MESSAGES_V1, normalizePagefindSearchFiltersV1, type PagefindSearchFilterV1, type PagefindSearchMessagesV1, type PagefindSearchRuntimeV1 } from "../search.js";

interface Props {
  base?: string;
  labels?: readonly string[];
  filters?: readonly PagefindSearchFilterV1[];
  runtime?: PagefindSearchRuntimeV1;
  messages?: Partial<Omit<PagefindSearchMessagesV1, "resultCount">> & { resultCount?: string };
}

const { base = "/", labels = [], filters, runtime = "auto", messages = {} } = Astro.props;
const normalizedBase = base === "/" ? "/" : `/${base.replace(/^\/+|\/+$/gu, "")}/`;
const copy = { ...DEFAULT_PAGEFIND_SEARCH_MESSAGES_V1, ...messages };
const searchFilters = normalizePagefindSearchFiltersV1(labels, filters);
const clientMessages = JSON.stringify({
  searching: copy.searching,
  noResults: copy.noResults,
  unavailable: copy.unavailable,
  resultCount: messages.resultCount ?? "{count} results",
});
---

<section
  data-atlcli-search
  data-atlcli-search-mode="page"
  data-atlcli-search-messages={clientMessages}
  data-pagefind-runtime={runtime}
  data-pagefind-url={`${normalizedBase}pagefind/pagefind.js`}
  aria-label={copy.pageLabel}
>
  <label>{copy.queryLabel}<input type="search" data-atlcli-search-input autocomplete="off" placeholder={copy.queryPlaceholder} /></label>
  {searchFilters.map((filter) => <label>{filter.name === "label" ? copy.filterLabel : filter.label}<select data-atlcli-search-filter={filter.name}><option value="">{copy.allFilters}</option>{filter.values.map((value) => <option value={value}>{value}</option>)}</select></label>)}
  <p data-atlcli-search-status aria-live="polite"></p>
  <ol data-atlcli-search-results></ol>
</section>

<script>
  import { initPagefindSearchV1 } from "./pagefind-search-client.ts";
  document.querySelectorAll<HTMLElement>("[data-atlcli-search]").forEach(initPagefindSearchV1);
</script>
