---
import { getEntry } from "astro:content";
import { publicationEditLinkV1, publicationStaticPathsV1, readPublicationNavigationV1 } from "@atlcli/web-publish-astro";
import PagefindSearch from "@atlcli/web-publish-astro/components/PagefindSearch.astro";
import PagefindSearchPage from "@atlcli/web-publish-astro/components/PagefindSearchPage.astro";
import { bundlePath, labelRoutePrefix } from "virtual:atlcli-publication";

export async function getStaticPaths() {
  return publicationStaticPathsV1({
    bundlePath,
    ...(labelRoutePrefix === undefined ? {} : { labelRoutePrefix }),
  });
}

const path = Astro.props;
const entry = path.kind === "page" ? await getEntry("publications", path.sourceId) : undefined;
if (path.kind === "page" && !entry) throw new Error(`Missing publication entry ${path.sourceId}`);
const loaded = await readPublicationNavigationV1({ bundlePath, ...(labelRoutePrefix === undefined ? {} : { labelRoutePrefix }) });
const labelLanding = path.kind === "label" ? loaded.navigation.labels.find((label) => label.slug === path.slug) : undefined;
// The frozen, origin-checked edit action of this page, or nothing.
const editLink = path.kind === "page" ? publicationEditLinkV1(loaded.bundle, path.sourceId) : undefined;
if (path.kind === "label" && !labelLanding) throw new Error(`Missing publication label landing ${path.slug}`);
const title = entry?.data.title ?? `Topic: ${labelLanding!.label}`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head><title>{title}</title></head>
  <body>
    <PagefindSearch base={base} labels={["guide"]} />
    <PagefindSearchPage
      base={base}
      labels={["guide"]}
      runtime="main-thread"
      messages={{
        pageLabel: "Search publication",
        queryLabel: "Find content",
        noResults: "Nothing matched.",
        resultCount: "{count} matching pages",
      }}
    />
    {path.kind === "page" ? <article data-atlcli-source-id={entry!.data.sourceId} data-atlcli-bundle={entry!.data.bundleDigest} data-pagefind-body>
      <span data-pagefind-filter="label">guide</span>
      <h1>{entry!.data.title}</h1>
      <p>Structured blocks: {entry!.data.blocks.length}</p>
      {editLink && <a href={editLink.href} rel="external" data-atlcli-edit-link data-pagefind-ignore>{editLink.label}</a>}
      <p>{"<img src=x onerror=alert('pagefind-hostile')> hostile-search-token"}</p>
    </article> : <article data-atlcli-label-slug={labelLanding!.slug} data-pagefind-body>
      <span data-pagefind-filter="label">{labelLanding!.label}</span>
      <h1>{title}</h1>
      <ul>{labelLanding!.sourceIds.map((sourceId) => <li>{sourceId}</li>)}</ul>
    </article>}
  </body>
</html>
