---
import { getEntry } from "astro:content";
import { publicationStaticPathsV1 } from "@atlcli/web-publish-astro";
import PagefindSearch from "@atlcli/web-publish-astro/components/PagefindSearch.astro";
import PagefindSearchPage from "@atlcli/web-publish-astro/components/PagefindSearchPage.astro";
import { bundlePath } from "virtual:atlcli-publication";

export async function getStaticPaths() {
  return publicationStaticPathsV1({
    bundlePath,
  });
}

const { sourceId } = Astro.props;
const entry = await getEntry("publications", sourceId);
if (!entry) throw new Error(`Missing publication entry ${sourceId}`);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head><title>{entry.data.title}</title></head>
  <body>
    <PagefindSearch base={base} labels={["guide"]} />
    <PagefindSearchPage
      base={base}
      labels={["guide"]}
      runtime="main-thread"
      messages={{
        pageLabel: "Search publication",
        queryLabel: "Find content",
        noResults: "Nothing matched.",
        resultCount: "{count} matching pages",
      }}
    />
    <article data-atlcli-source-id={entry.data.sourceId} data-atlcli-bundle={entry.data.bundleDigest} data-pagefind-body>
      <span data-pagefind-filter="label">guide</span>
      <h1>{entry.data.title}</h1>
      <p>Structured blocks: {entry.data.blocks.length}</p>
      <p>{"<img src=x onerror=alert('pagefind-hostile')> hostile-search-token"}</p>
    </article>
  </body>
</html>
