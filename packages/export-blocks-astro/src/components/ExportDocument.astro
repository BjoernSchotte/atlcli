---
import type { ExportBlock } from "@atlcli/export-blocks";
import Block from "./Block.astro";
import type { AstroExportBlockRenderContextV1 } from "../index.js";

interface Props {
  blocks: readonly ExportBlock[];
  context: AstroExportBlockRenderContextV1;
}

const { blocks, context } = Astro.props;
---

<article data-atlcli-document data-atlcli-block-count={blocks.length} lang={context.locale} dir={context.direction}>
  {blocks.map((block) => <Block block={block} context={context} />)}
</article>
