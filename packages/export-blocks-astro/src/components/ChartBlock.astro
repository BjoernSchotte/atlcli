---
import {
  chartModelDigestV1,
  validateChartModelV1,
  type ExportBlock,
} from "@atlcli/export-blocks";
import {
  renderTanStackChartSvgV1,
  TanStackChartRenderBudgetErrorV1,
  TANSTACK_CHART_ADAPTER_V1,
  TANSTACK_CHART_SIZE_V1,
} from "@atlcli/export-charts-tanstack";
import type { AstroExportBlockRenderContextV1 } from "../index.js";
import Caption from "./Caption.astro";
import ChartTable from "./ChartTable.astro";

interface Props {
  block: Extract<ExportBlock, { type: "chart" }>;
  context: AstroExportBlockRenderContextV1;
}

const { block, context } = Astro.props;
const chart = validateChartModelV1(block.chart);
const title = chart.title || `${chart.kind} chart`;
const digest = chartModelDigestV1(chart);
const chartId = `atlcli-chart-${digest}`;
const displayData = chart.display?.data ?? "hidden";
const diagnostics = block.diagnostics ?? [];
const sourceDiagnosticsText = diagnostics.map((diagnostic) => diagnostic.message).join(" ");
const description = chart.data.mode === "categories"
  ? chart.data.series.map((series) => `${series.label}: ${series.values.join(", ")}`).join("; ")
  : chart.data.mode === "points"
    ? chart.data.series.map((series) => `${series.label}: ${series.points.map((point) => `${point.x}=${point.y}`).join(", ")}`).join("; ")
    : chart.data.tasks.map((task) => `${task.label}: ${task.start} to ${task.end}`).join("; ");
const width = chart.display?.width ?? TANSTACK_CHART_SIZE_V1.width;
const height = chart.display?.height ?? TANSTACK_CHART_SIZE_V1.height;

// This is the only trusted markup seam in the chart component. The adapter
// validates the closed ChartModelV1 and escapes every source-derived label
// before returning deterministic SVG; provider HTML never reaches set:html.
let svg: string | undefined;
let budgetFallback: string | undefined;
try {
  svg = renderTanStackChartSvgV1(chart, {
    width,
    height,
    idPrefix: chartId,
    ariaLabel: title,
    ariaDescription: description,
    ...(context.chartPolicy === undefined ? {} : { budget: {
      maxSceneNodes: context.chartPolicy.static.maxSvgNodes,
      maxSvgBytes: context.chartPolicy.static.maxSvgBytes,
      maxRenderMs: context.chartPolicy.static.maxRenderMs,
    } }),
  });
} catch (error) {
  if (!(error instanceof TanStackChartRenderBudgetErrorV1) || context.chartPolicy?.strict !== false) throw error;
  budgetFallback = `The static chart exceeded its ${error.resource} budget; the complete data table remains available.`;
}
const diagnosticsText = [sourceDiagnosticsText, budgetFallback].filter(Boolean).join(" ");
const hasDiagnostics = diagnosticsText.length > 0;
const accessibleDescription = hasDiagnostics ? `${description} Chart notes: ${diagnosticsText}` : description;
const effectiveDataDisplay = budgetFallback === undefined ? displayData : "after";
const figureStyle = [
  chart.style?.backgroundColor ? `background:${chart.style.backgroundColor}` : "",
  chart.style?.borderColor ? `border:1px solid ${chart.style.borderColor}` : "",
].filter(Boolean).join(";");
---

<figure
  id={chartId}
  data-atlcli-block="chart"
  data-atlcli-chart-kind={chart.kind}
  data-atlcli-chart-orientation={chart.orientation}
  data-atlcli-chart-stacked={chart.stacked ? "true" : undefined}
  data-atlcli-chart-adapter={TANSTACK_CHART_ADAPTER_V1.id}
  data-atlcli-chart-diagnostics={hasDiagnostics ? "true" : undefined}
  aria-describedby={`${chartId}-description`}
  style={figureStyle || undefined}
>
  <header data-atlcli-chart-heading>
    <h3>{title}</h3>
    {chart.subtitle && <p>{chart.subtitle}</p>}
  </header>
  <p id={`${chartId}-description`} class="atlcli-chart-description">{accessibleDescription}</p>
  {hasDiagnostics && <aside class="atlcli-chart-diagnostics" data-atlcli-chart-diagnostics role="status">
    <strong>Chart data note:</strong> {diagnosticsText}
  </aside>}
  {effectiveDataDisplay === "before" && <ChartTable data={chart.data} title={title} />}
  {effectiveDataDisplay === "hidden" && <div class="atlcli-chart-data-visually-hidden" data-atlcli-chart-data-display="hidden">
    <ChartTable data={chart.data} title={title} />
  </div>}
  {svg !== undefined ? <div
    data-atlcli-chart-visual="tanstack-svg"
    data-atlcli-chart-legend={chart.legend ?? "top"}
    role="group"
    aria-label={`${title} scrollable chart visual`}
    tabindex="0"
    set:html={svg}
  /> : <aside data-atlcli-chart-budget-fallback role="status">Static chart visual unavailable within the configured resource budget.</aside>}
  {effectiveDataDisplay === "after" && <ChartTable data={chart.data} title={title} />}
  {block.caption && <Caption caption={block.caption} locale={context.locale} context={context} />}
</figure>
