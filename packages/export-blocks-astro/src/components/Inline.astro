---
import type { InlineNode } from "@atlcli/export-blocks";
import type { AstroExportBlockRenderContextV1 } from "../index.js";
import InlineNodeView from "./InlineNode.astro";

interface Props { nodes: readonly InlineNode[]; locale: string; context: AstroExportBlockRenderContextV1; }
const { nodes, locale, context } = Astro.props;
---

{nodes.map((node) => <InlineNodeView node={node} locale={locale} context={context} />)}
