{
  "name": "@atlcli/jinja",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "atlcli": {
    "publish": "public-0.x"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "vendor": "bun scripts/vendor-nunjucks.ts",
    "prepack": "bun ../../scripts/strip-dev-condition.ts strip",
    "postpack": "bun ../../scripts/strip-dev-condition.ts restore"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "nunjucks": "3.2.4"
  }
}
