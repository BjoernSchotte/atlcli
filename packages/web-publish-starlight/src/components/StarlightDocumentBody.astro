---
import ExportDocument from "@atlcli/export-blocks-astro/components/ExportDocument.astro";
import type {
  AstroExportBlockOverridesV1,
  AstroExportBlockRenderContextV1,
} from "@atlcli/export-blocks-astro";
import type { ExportBlock } from "@atlcli/export-blocks";
import StarlightCodeBlock from "./StarlightCodeBlock.astro";

interface Props {
  blocks: readonly ExportBlock[];
  context: AstroExportBlockRenderContextV1;
  overrides?: AstroExportBlockOverridesV1;
}

const { blocks, context, overrides } = Astro.props;
const starlightOverrides: AstroExportBlockOverridesV1 = { code: StarlightCodeBlock, ...overrides };
---

<section data-atlcli-starlight-slot="main-content">
  <ExportDocument blocks={blocks} context={context} overrides={starlightOverrides} />
</section>
