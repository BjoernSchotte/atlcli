{
  "name": "@atlcli/web-publish-starlight",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "atlcli": {
    "publish": "public-0.x"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "bun ../../scripts/strip-dev-condition.ts strip",
    "postpack": "bun ../../scripts/strip-dev-condition.ts restore"
  },
  "dependencies": {
    "@atlcli/export-blocks-astro": "workspace:*"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.3",
    "astro": ">=7.1.6 <8"
  }
}
