---
import { EXPORT_BLOCKS_ASTRO_MINIMAL_CONTEXT_V1 } from "@atlcli/export-blocks-astro/fixtures";
import InteractiveChart from "@atlcli/export-blocks-astro/components/InteractiveChart.astro";
import StarlightPublicationPage from "@atlcli/web-publish-starlight/components/StarlightPublicationPage.astro";
import {
  PUBLISHED_CHART_NAVIGATION_V1,
  PUBLISHED_CHART_PAGE_V1,
  PUBLISHED_INTERACTIVE_CHART_BLOCKS_V1,
  PUBLISHED_STARLIGHT_NAVIGATION_V1,
} from "../publication-navigation";

const staticChartContext = {
  ...EXPORT_BLOCKS_ASTRO_MINIMAL_CONTEXT_V1,
  chartPolicy: {
    strict: true,
    acquisition: { maxDurationMs: 300_000, maxAggregateBytes: 16_777_216 },
    normalization: { maxRows: 2_000, maxSeries: 64, maxPoints: 20_000, maxBytes: 524_288 },
    static: { maxSvgNodes: 100_000, maxSvgBytes: 2_097_152, maxRenderMs: 2_000 },
    island: { enabled: false, maxRows: 80, maxSeries: 12, maxPoints: 800, maxBytes: 65_536, maxMountMs: 250 },
  },
};
const interactiveChartContext = {
  ...staticChartContext,
  chartPolicy: {
    ...staticChartContext.chartPolicy,
    island: { ...staticChartContext.chartPolicy.island, enabled: true },
  },
};
---

<StarlightPublicationPage
  page={PUBLISHED_CHART_PAGE_V1}
  navigation={PUBLISHED_CHART_NAVIGATION_V1}
  sidebar={PUBLISHED_STARLIGHT_NAVIGATION_V1.sidebar}
  context={staticChartContext}
>
  <section slot="after-content" aria-labelledby="interactive-enhancement">
    {PUBLISHED_INTERACTIVE_CHART_BLOCKS_V1.map((block) =>
      <InteractiveChart block={block} context={interactiveChartContext} />
    )}
  </section>
</StarlightPublicationPage>
