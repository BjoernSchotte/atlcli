---
import type { ExportBlock } from "@atlcli/export-blocks";
import InteractiveChart from "@atlcli/export-blocks-astro/components/InteractiveChart.astro";
import { EXPORT_BLOCKS_ASTRO_MINIMAL_CONTEXT_V1 } from "@atlcli/export-blocks-astro/fixtures";
import "@atlcli/export-blocks-astro/styles.css";

const labels = Array.from({ length: 66 }, (_, index) => `Category ${index + 1}`);
const budgetBlock = {
  type: "chart",
  chart: {
    schema: "atlcli.chart/1",
    kind: "bar",
    title: "Runtime budget fallback proof",
    data: {
      mode: "categories",
      labels,
      series: Array.from({ length: 12 }, (_, seriesIndex) => ({
        id: `series-${seriesIndex + 1}`,
        label: `Series ${seriesIndex + 1}`,
        values: labels.map((_, rowIndex) => (seriesIndex + 1) * (rowIndex + 1)),
      })),
    },
    source: { kind: "cloud-adf", macroName: "chart" },
  },
} as const satisfies Extract<ExportBlock, { type: "chart" }>;
const budgetContext = {
  ...EXPORT_BLOCKS_ASTRO_MINIMAL_CONTEXT_V1,
  chartPolicy: {
    strict: true,
    acquisition: { maxDurationMs: 300_000, maxAggregateBytes: 16_777_216 },
    normalization: { maxRows: 2_000, maxSeries: 64, maxPoints: 20_000, maxBytes: 524_288 },
    static: { maxSvgNodes: 100_000, maxSvgBytes: 2_097_152, maxRenderMs: 2_000 },
    island: { enabled: true, maxRows: 80, maxSeries: 12, maxPoints: 800, maxBytes: 65_536, maxMountMs: 1 },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TanStack chart runtime budget proof</title>
    <style is:global>
      body { margin: 0; color: #172b4d; font-family: system-ui, sans-serif; }
      main { box-sizing: border-box; margin-inline: auto; max-inline-size: 72rem; padding: 1rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>TanStack chart runtime budget proof</h1>
      <InteractiveChart block={budgetBlock} context={budgetContext} />
    </main>
  </body>
</html>
