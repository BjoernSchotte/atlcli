{
  "name": "atlcli",
  "version": "0.17.2",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun --conditions=development run --cwd apps/cli src/index.ts",
    "fonts:ensure": "bun packages/pdf/scripts/ensure-fonts.ts",
    "vendor:typst": "bun packages/pdf-compiler-browser/scripts/vendor-typst.ts",
    "clean:browser-artifacts": "bun scripts/clean-browser-artifacts.ts all",
    "clean:extension-output": "bun scripts/clean-browser-artifacts.ts extension",
    "clean:browser-export-harness-output": "bun scripts/clean-browser-artifacts.ts harness",
    "postinstall": "bun run vendor:typst",
    "prebuild": "bun run fonts:ensure && bun run vendor:typst && bun run clean:browser-artifacts",
    "build": "turbo run build",
    "release": "bun scripts/release.ts",
    "build:cli": "bun run --cwd apps/cli build",
    "lint": "echo 'no lint configured'",
    "test": "bun --conditions=development test",
    "typecheck": "bunx tsc --noEmit && bun run typecheck:extension && bun run typecheck:pdf-compiler-browser && bun run typecheck:browser-export-harness",
    "check:browser": "bun scripts/check-browser-build.ts",
    "typecheck:extension": "turbo run typecheck --filter=@atlcli/extension",
    "typecheck:pdf-compiler-browser": "turbo run typecheck --filter=@atlcli/pdf-compiler-browser",
    "typecheck:browser-export-harness": "turbo run typecheck --filter=@atlcli/browser-export-harness",
    "prebuild:browser-export-harness": "bun run clean:browser-export-harness-output",
    "build:browser-export-harness": "turbo run build --filter=@atlcli/browser-export-harness",
    "check:browser-export-harness": "bun run --cwd apps/browser-export-harness check:output",
    "assert:conformance-cases": "bun run --cwd apps/browser-export-harness assert:cases",
    "check:parity": "bun run --cwd apps/browser-export-harness check:parity",
    "bench:m1": "bun --conditions=development scripts/bench/run-m1-acceptance.ts",
    "bench:engine": "bun --conditions=development scripts/bench/run-bench.ts",
    "bench:e2e": "bun --conditions=development scripts/bench/run-e2e-bench.ts",
    "bench:memory-chrome": "bun run --cwd apps/extension bench:memory-chrome",
    "bench:export-baseline-node": "bun --conditions=development scripts/bench/run-export-baseline.ts",
    "bench:export-baseline-chrome": "bun --conditions=development scripts/bench/run-chrome-export-baseline.ts",
    "bench:export-jobs-node": "bun --conditions=development scripts/bench/run-export-job-baseline.ts",
    "bench:export-jobs-chrome": "bun --conditions=development scripts/bench/run-chrome-export-job-baseline.ts",
    "test:browser-export-harness": "bun run --cwd apps/browser-export-harness test:e2e",
    "check:extension-output": "bun run --cwd apps/extension check:output",
    "obfuscate": "terser dist/index.js --compress --mangle --output dist/index.js",
    "prebuild:prod": "bun run fonts:ensure && bun run vendor:typst && bun run clean:browser-artifacts",
    "build:prod": "turbo run build && bun run obfuscate",
    "version:core": "npm version --no-git-tag-version -w @atlcli/core -w @atlcli/confluence -w @atlcli/plugin-api",
    "version:cli": "npm version --no-git-tag-version -w @atlcli/cli",
    "docs:dev": "astro dev",
    "docs:check": "astro check --tsconfig ./tsconfig.docs.json",
    "docs:build": "astro build",
    "docs:preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@atlcli/confluence": "workspace:*",
    "@atlcli/docx": "workspace:*",
    "@atlcli/export-fixtures": "workspace:*",
    "@atlcli/export-jobs": "workspace:*",
    "@atlcli/export-macros": "workspace:*",
    "@atlcli/export-node": "workspace:*",
    "@atlcli/export-wiring": "workspace:*",
    "@atlcli/pdf": "workspace:*",
    "@atlcli/pdf-compiler-browser": "workspace:*",
    "astro": "^7.0.7",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "25.0.5",
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.3.5",
    "github-slugger": "^2.0.0",
    "terser": "^5.44.1",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "@myriaddreamin/typst-ts-web-compiler@0.7.0": "patches/@myriaddreamin%2Ftypst-ts-web-compiler@0.7.0.patch"
  }
}
