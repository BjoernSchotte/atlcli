{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "npm", "github-actions"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 3,
  "automerge": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/fixtures/**",
    "spec/**",
    "specs/**",
    "spikes/**"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["astro", "@astrojs/*"],
      "groupName": "Astro"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Review local patches and the deepagents override before approving research stack updates.",
      "matchPackageNames": ["deepagents", "@langchain/*"],
      "groupName": "LangChain and deepagents",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review the local webdav-server patch before approving updates.",
      "matchPackageNames": ["webdav-server"],
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true
    }
  ]
}
