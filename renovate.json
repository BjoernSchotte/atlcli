{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "npm", "github-actions", "asdf", "custom.regex"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 3,
  "automerge": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/fixtures/**",
    "specs/**",
    "spikes/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/reusable-release-artifacts\\.yml$/"
      ],
      "matchStrings": [
        "BUN_VERSION: \"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "bun",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "oven-sh/bun",
      "extractVersionTemplate": "^bun-v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Homebrew/actions tags are YYYY.MM.DD.N; the github-actions manager reads at most three version parts from the pin comment and then fails the digest lookup.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: Homebrew/actions/[\\w-]+@(?<currentDigest>[a-f0-9]{40}) # (?<currentValue>\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+)"
      ],
      "depNameTemplate": "Homebrew/actions",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Batch stable non-major packages; keep pre-1.0 upgrades separate.",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": "Stable non-major dependencies"
    },
    {
      "matchPackageNames": ["astro", "@astrojs/*"],
      "groupName": "Astro"
    },
    {
      "description": "@opentui/react pins an exact @opentui/core; update both together or two cores get installed.",
      "matchPackageNames": ["@opentui/*"],
      "groupName": "OpenTUI"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "description": "Bump ranges too: an exact pin elsewhere would otherwise hoist react past react-dom, and React refuses mismatched versions.",
      "rangeStrategy": "bump",
      "groupName": "React"
    },
    {
      "description": "Review local patches and the deepagents override before approving research stack updates.",
      "matchPackageNames": ["deepagents", "@langchain/*", "langchain", "langsmith"],
      "groupName": "LangChain and deepagents",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review the local webdav-server patch before approving updates.",
      "matchPackageNames": ["webdav-server"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review the pinned Chromium evidence baseline before updating Playwright.",
      "matchPackageNames": ["@playwright/test"],
      "groupName": "Playwright",
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "description": "Match action names, not runtime sources such as actions/node-versions.",
      "matchDepNames": ["actions/**"],
      "groupName": "GitHub Actions",
      "separateMajorMinor": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["bun", "oven-sh/bun"],
      "groupName": "Bun runtime",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Updated by the Homebrew/actions custom regex manager instead.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["Homebrew/actions"],
      "enabled": false
    }
  ]
}
