{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "npm", "github-actions", "asdf", "custom.regex"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 3,
  "automerge": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/fixtures/**",
    "spec/**",
    "specs/**",
    "spikes/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/reusable-release-artifacts\\.yml$/"
      ],
      "matchStrings": [
        "BUN_VERSION: \"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "bun",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "oven-sh/bun",
      "extractVersionTemplate": "^bun-v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Batch stable non-major packages; keep pre-1.0 upgrades separate.",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": "Stable non-major dependencies"
    },
    {
      "matchPackageNames": ["astro", "@astrojs/*"],
      "groupName": "Astro"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "description": "Review local patches and the deepagents override before approving research stack updates.",
      "matchPackageNames": ["deepagents", "@langchain/*", "langchain", "langsmith"],
      "groupName": "LangChain and deepagents",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review the local webdav-server patch before approving updates.",
      "matchPackageNames": ["webdav-server"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/**"],
      "groupName": "GitHub Actions",
      "separateMajorMinor": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["bun", "oven-sh/bun"],
      "groupName": "Bun runtime",
      "dependencyDashboardApproval": true
    }
  ]
}
